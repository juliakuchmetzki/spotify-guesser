# Spotify App: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
SPOTIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
# Spotify erlaubt kein "localhost" mehr als Redirect-URI – Loopback-IP verwenden.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/auth/callback
DATABASE_URL=./db/game.db
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
NODE_ENV=development
PORT=5000
# Nur lokal lauschen, wenn ein Reverse Proxy (Caddy) davor sitzt – sonst weglassen
# HOST=127.0.0.1
FRONTEND_URL=http://127.0.0.1:3000

# --- Beispiel Produktion (Caddy + Vercel) ---
# SPOTIFY_REDIRECT_URI=https://DEIN-NAME.duckdns.org/api/auth/callback
# FRONTEND_URL=https://spotify-guesser-pi.vercel.app
# NODE_ENV=production
# HOST=127.0.0.1
